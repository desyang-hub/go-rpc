{
  "name": "go-rpc-ts-client",
  "version": "1.0.0",
  "description": "TypeScript gRPC-Web client for rpc-gen Go Server",
  "main": "client.ts",
  "scripts": {
    "proto:generate": "protoc --js_out=import_mode=copy,index_package:./proto --grpc-web_out=import_mode=copy,index_package:./proto --proto_path=../../api api/*.proto",
    "dev": "ts-node client.ts",
    "build": "tsc --build"
  },
  "dependencies": {
    "grpc-web": "^1.4.0",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0"
  }
}
